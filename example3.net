-- Example 3: 4-input majority implemented with gates
-- Y = majority(A,B,C,D) (output 1 if at least 3 inputs are 1)

entity ex3 is
port (
A : in std_logic;
B : in std_logic;
C : in std_logic;
D : in std_logic;
Y : out std_logic
);
end ex3;

architecture structural of ex3 is
signal N1 : std_logic;
signal N2 : std_logic;
signal N3 : std_logic;

begin
-- pairwise ANDs
G1 : and_gate port map (A, B, N1);
G2 : and_gate port map (A, C, N2);
G3 : and_gate port map (B, C, N3);
-- majority if any two of (A,B,C) and D or combinations
signal M1 : std_logic;
G4 : or_gate  port map (N1, N2, M1);
G5 : or_gate  port map (M1, N3, M1);
-- final: (majority of A,B,C) AND D  OR  (pairwise combos including D)
signal P1 : std_logic;
G6 : and_gate port map (M1, D, P1);
G7 : and_gate port map (A, B, N1);
G8 : or_gate  port map (P1, N1, Y);

end structural;
